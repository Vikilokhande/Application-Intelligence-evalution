# ==============================================================================
# DECC Environmental Review Portal — Environment Configuration Template
# Copy this file to .env and backend/.env and populate with your environment values.
# ==============================================================================

# ── Application Configuration ────────────────────────────────────────────────
APP_NAME="DECC Environmental Review Portal"
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DEMO_MODE=true
AUTH_ENABLED=false

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (Default Local):
DATABASE_URL=sqlite:///./application_intelligence.db
# PostgreSQL (Production Example):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/decc_review_db

# ── Storage Paths ────────────────────────────────────────────────────────────
CHROMA_PATH=../data/chroma
KNOWLEDGE_PATH=../data/knowledge
UPLOAD_DIR=../data/uploads
MAX_UPLOAD_BYTES=26214400
ALLOWED_EXTENSIONS=pdf,docx,xlsx,csv,jpg,jpeg,png,json,txt,tiff,tif

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── LLM Provider (OpenRouter / OpenAI-Compatible) ────────────────────────────
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=90
LLM_MAX_TOKENS=4096

# Primary Model (e.g. z-ai/glm-5.2:free, minimax/minimax-m3:free)
LLM_MODEL=z-ai/glm-5.2:free

# Fallback Model on 429/Timeout
LLM_FALLBACK_MODEL=openrouter/auto

# Retry Configuration
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=3.0

# AI Reasoning Model (used for post-scoring case narrative)
GROQ_REASONING_MODEL=z-ai/glm-5.2:free

# API Key (Set OPENROUTER_API_KEY for cloud inference; leave blank if DEMO_MODE=true)
OPENROUTER_API_KEY=

# ── OCR Configuration ────────────────────────────────────────────────────────
OCR_ENABLED=true
OCR_PROVIDER=tesseract
OCR_LANGUAGE=eng
OCR_TIMEOUT=60
OCR_MIN_TEXT_LENGTH=100
OCR_MIN_TEXT_RATIO=0.10
# On Windows, specify full path if tesseract is not in system PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ── Embeddings & Semantic RAG ────────────────────────────────────────────────
# 'sentence_transformers' (Production semantic search) | 'local' (Deterministic hash fallback)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── ML Scoring Models ────────────────────────────────────────────────────────
# 'xgboost' (Production 3-model ensemble) | 'baseline' (Development rule-based) | 'unavailable'
ML_PROVIDER=xgboost
ML_MODEL_PATH=../backend/app/ml/application_intelligence_xgboost_training_artifacts/models/risk_classifier.ubj
ML_FEATURE_SCHEMA_PATH=../backend/app/ml/application_intelligence_xgboost_training_artifacts/models/feature_schema.json
ML_MODEL_VERSION=1.0

# ── Validation & Anomaly Thresholds ──────────────────────────────────────────
SUSPICIOUS_COST_THRESHOLD=10000000
CONTRADICTION_ABSOLUTE_TOLERANCE=5000
CONTRADICTION_RELATIVE_TOLERANCE=0.02

# ── Reviewer Routing Policy ──────────────────────────────────────────────────
ROUTING_POLICY_VERSION=1.0
ROUTING_CONFIDENCE_THRESHOLD=0.55
ROUTING_SENIOR_RISK_THRESHOLD=70.0
ROUTING_EXPERT_RISK_THRESHOLD=40.0

# ── Security & Authentication ────────────────────────────────────────────────
JWT_SECRET=GENERATE_A_SECURE_RANDOM_SECRET_KEY_FOR_PRODUCTION
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ── SMTP / Email Clearance Reports ───────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# ── Frontend Configuration ───────────────────────────────────────────────────
# In frontend/.env:
VITE_API_BASE_URL=http://localhost:8000/api/v1
