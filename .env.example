APP_NAME=Application Intelligence Platform
ENVIRONMENT=development
DATABASE_URL=sqlite:///./application_intelligence.db
CHROMA_PATH=../data/chroma
KNOWLEDGE_PATH=../data/knowledge
UPLOAD_DIR=../data/uploads
ALLOWED_EXTENSIONS=pdf,docx,xlsx,csv,jpg,jpeg,png,json,txt,tiff,tif
MAX_UPLOAD_BYTES=26214400
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DEMO_MODE=true
AUTH_ENABLED=false

# ── LLM Provider ─────────────────────────────────────────────────────────────
LLM_PROVIDER=groq
LLM_MODEL=llama3-8b-8192
LLM_BASE_URL=https://api.groq.com/openai/v1
# Set one of the following (QROQ_API_KEY is supported for backward compatibility):
GROQ_API_KEY=<your-groq-api-key>
# QROQ_API_KEY=<your-groq-api-key>
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=60
LLM_MAX_TOKENS=4096
LLM_MAX_RETRIES=3

# ── OCR ───────────────────────────────────────────────────────────────────────
OCR_ENABLED=true
OCR_PROVIDER=tesseract
OCR_LANGUAGE=eng
OCR_TIMEOUT=60
OCR_MIN_TEXT_LENGTH=100
OCR_MIN_TEXT_RATIO=0.10
# On Windows, set the full path to tesseract.exe if not on PATH:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ── Embedding ─────────────────────────────────────────────────────────────────
# Use 'local' for development (deterministic, no real semantic search)
# Use 'sentence_transformers' for production (real semantic search)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── ML Scoring ───────────────────────────────────────────────────────────────
# 'xgboost'    → loads ml/models/model.ubj (train first with ml/training/train.py)
# 'baseline'   → deterministic formula, labeled GENERATED_DEVELOPMENT_MODEL
# 'unavailable'→ explicit MODEL_UNAVAILABLE status (safe default before training)
ML_PROVIDER=unavailable
ML_MODEL_PATH=../ml/models/model.ubj
ML_FEATURE_SCHEMA_PATH=../ml/models/feature_schema.json

# ── Validation Thresholds ─────────────────────────────────────────────────────
SUSPICIOUS_COST_THRESHOLD=10000000
CONTRADICTION_ABSOLUTE_TOLERANCE=5000
CONTRADICTION_RELATIVE_TOLERANCE=0.02

# ── Routing Policy ────────────────────────────────────────────────────────────
ROUTING_POLICY_VERSION=1.0
ROUTING_CONFIDENCE_THRESHOLD=0.55
ROUTING_SENIOR_RISK_THRESHOLD=70.0
ROUTING_EXPERT_RISK_THRESHOLD=40.0

# ── Security ──────────────────────────────────────────────────────────────────
JWT_SECRET=<generate-a-long-random-secret-for-production>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
